<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Keep material access aligned with the task rules in tsm_base. -->
    <record id="tsm_task_material_manager_rule" model="ir.rule">
        <field name="name">TSM Material: managers by company</field>
        <field name="model_id" ref="model_tsm_task_material" />
        <field name="domain_force">[('task_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('tsm_base.group_tsm_manager'))]" />
    </record>
    <record id="tsm_task_material_public_followers_rule" model="ir.rule">
        <field name="name">TSM Material: public tasks or followers</field>
        <field name="model_id" ref="model_tsm_task_material" />
        <field name="domain_force">[
            ('task_id.company_id', 'in', company_ids), '|',
            ('task_id.privacy_visibility', '!=', 'followers'),
            ('task_id.message_partner_ids', 'in', [user.partner_id.id])
        ]</field>
        <field name="groups" eval="[(4, ref('tsm_base.group_tsm_user'))]" />
        <field name="perm_create" eval="False" />
        <field name="perm_write" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="tsm_task_material_assigned_user_rule" model="ir.rule">
        <field name="name">TSM Material: assigned task user can modify</field>
        <field name="model_id" ref="model_tsm_task_material" />
        <field name="domain_force">[
            ('task_id.company_id', 'in', company_ids), ('task_id.user_id', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('tsm_base.group_tsm_user'))]" />
        <field name="perm_read" eval="False" />
    </record>
</odoo>
