<odoo>
    <!-- Timesheet Lines Tree -->
    <record id="tsm_task_timesheet_line_tree_time_pack_view" model="ir.ui.view">
        <field name="name">TSM Task Tmesheet Line Tree Time Pack</field>
        <field name="model">tsm.task.timesheet</field>
        <field
            name="inherit_id"
            ref="tsm_task_timesheet.tsm_task_timesheet_line_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="before">
                <field name="task_partner_id" column_invisible="True" />
                <field
                    name="timepack_id"
                    domain="[('partner_id', '=', task_partner_id)]"
                    options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"
                />
                <button
                    type="object"
                    name="view_time_pack"
                    title="View Time Pack Details"
                    icon="fa-search-plus"
                    invisible="not timepack_id"
                />
                <field name="discount_time" invisible="not timepack_id" />
            </xpath>
        </field>
    </record>

    <!-- Timesheet Lines Form -->
    <record id="tsm_task_timesheet_line_form_time_pack_view" model="ir.ui.view">
        <field name="name">TSM Task Tmesheet Line Form Time Pack</field>
        <field name="model">tsm.task.timesheet</field>
        <field
            name="inherit_id"
            ref="tsm_task_timesheet.tsm_task_timesheet_line_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='duration']" position="after">
                <label for="timepack_id" string="Time Pack" />
                <div name="time_pack">
                    <field
                        name="timepack_id"
                        class="oe_inline"
                        domain="[('partner_id', '=', task_partner_id)]"
                        options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"
                    />
                    <button
                        type="object"
                        name="view_time_pack"
                        icon="fa-search-plus"
                        class="oe_stat_button"
                        title="View Time Pack Details"
                        invisible="not timepack_id"
                    />
                </div>
                <field name="discount_time" invisible="not timepack_id" />
            </xpath>
        </field>
    </record>
</odoo>
