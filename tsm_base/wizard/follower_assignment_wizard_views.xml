<odoo>

    <record id="follower_assignment_wizard_view" model="ir.ui.view">
        <field name="name">follower.assignment.wizard form</field>
        <field name="model">follower.assignment.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign/Unassign Followers">
                <group>
                    <field name="record_followers_ids" nolabel="1" required="1" />
                </group>
                <footer>
                    <button
                        name="assign_followers"
                        string="Assign"
                        type="object"
                        class="oe_highlight"
                    />
                    or
                    <button
                        name="update_followers"
                        string="Remove"
                        type="object"
                        class="oe_highlight"
                    />
                    or
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
