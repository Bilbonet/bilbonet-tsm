<odoo>
    <!-- =======================
       Timesheet My lines: Views
    ======================== -->
    <record id="tsm_task_timesheet_line_tree_commission_view" model="ir.ui.view">
        <field name="name">tsm.task.timesheet.line.tree Commission</field>
        <field name="model">tsm.task.timesheet</field>
        <field
            name="inherit_id"
            ref="tsm_task_timesheet.tsm_task_timesheet_line_tree"
        />
        <field name="arch" type="xml">
            <!-- Show total commissions in the line -->
            <xpath expr="//field[@name='amount']" position="after">
                <field name="any_settled" column_invisible="1" />
                <!-- Keep agent values in onchange responses for unsaved timesheets. -->
                <field name="agent_ids" column_invisible="1">
                    <list>
                        <field name="agent_id" />
                        <field name="commission_id" />
                        <field name="specific_price" />
                        <field name="price_unit" />
                    </list>
                </field>
                <field name="currency_id" column_invisible="1" />
                <field
                    name="commission_amount"
                    optional="hide"
                    sum="Total Commission"
                    options="{'currency_field': 'currency_id'}"
                    widget="monetary"
                    readonly="1"
                    invisible="commission_amount == 0"
                />
            </xpath>
            <!-- Protect timesheet fields while any commission is settled. -->
            <xpath expr="//field[@name='date_time']" position="attributes">
                <attribute name="readonly">any_settled</attribute>
            </xpath>
            <xpath expr="//field[@name='task_id']" position="attributes">
                <attribute name="readonly">any_settled</attribute>
            </xpath>
            <xpath expr="//field[@name='amount']" position="attributes">
                <attribute name="readonly">any_settled</attribute>
            </xpath>
        </field>
    </record>

    <!-- ========================
       Timesheet All lines: Views
    ========================= -->
    <record id="tsm_task_timesheet_all_line_tree_commission_view" model="ir.ui.view">
        <field name="name">tsm.task.timesheet.all.line.tree Commission</field>
        <field name="model">tsm.task.timesheet</field>
        <field
            name="inherit_id"
            ref="tsm_task_timesheet.tsm_task_timesheet_all_line_tree"
        />
        <field name="arch" type="xml">
            <!-- Protect timesheet fields while any commission is settled. -->
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="readonly">any_settled</attribute>
            </xpath>
        </field>
    </record>

    <!-- ========================
       Time Pack: Timesheet Views
    ========================= -->
    <record
        id="tsm_task_timesheet_line_tree_time_pack_commission_view"
        model="ir.ui.view"
    >
        <field name="name">tsm.task.timesheet Time Pack Commission</field>
        <field name="model">tsm.task.timesheet</field>
        <field
            name="inherit_id"
            ref="tsm_time_pack.tsm_task_timesheet_line_tree_time_pack_view"
        />
        <field name="arch" type="xml">
            <!-- Protect timesheet fields while any commission is settled. -->
            <xpath expr="//field[@name='timepack_id']" position="attributes">
                <attribute name="readonly">any_settled</attribute>
            </xpath>
            <xpath expr="//field[@name='discount_time']" position="attributes">
                <attribute name="invisible">not timepack_id</attribute>
                <attribute name="readonly">any_settled</attribute>
            </xpath>
        </field>
    </record>
</odoo>
