<odoo>

    <record id="commission_tsm_time_pack_form_view" model="ir.ui.view">
        <field name="name">tsm.time.pack Commission</field>
        <field name="model">tsm.time.pack</field>
        <field name="inherit_id" ref="tsm_time_pack.tsm_time_pack_form_view" />
        <field name="arch" type="xml">
            <!-- Avoid changes in some fields if there is any commission set -->
            <xpath expr="//field[@name='timesheet_ids']/tree" position="inside">
                <field name="agent_ids" invisible="1" />
            </xpath>
            <xpath
                expr="//field[@name='timesheet_ids']//field[@name='amount']"
                position="attributes"
            >
                <attribute
                    name="attrs"
                >{'readonly': [('agent_ids', '!=', [])]}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='timesheet_ids']//field[@name='discount_time']"
                position="attributes"
            >
                <attribute
                    name="attrs"
                >{'readonly': [('agent_ids', '!=', [])]}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
