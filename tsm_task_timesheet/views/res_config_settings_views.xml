<?xml version="1.0" ?>
<odoo>
    <record id="view_res_config_settings" model="ir.ui.view">
        <field name="name">TSM Task Timesheet Settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="tsm_base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <app name="tsm_base" position="inside">
                <block title="TSM Timesheet Settings">
                    <setting
                        id="use_title_in_timesheets"
                        help="Use title to describe timesheet."
                    >
                        <field name="group_tsm_timesheet_title" />
                    </setting>
                    <setting
                        id="use_tags_in_timesheets"
                        help="Use tags to classify timesheet."
                    >
                        <field name="group_tsm_timesheet_tag" />
                    </setting>
                </block>
            </app>
        </field>
    </record>
</odoo>
