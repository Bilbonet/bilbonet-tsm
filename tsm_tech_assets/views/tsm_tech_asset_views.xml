<odoo>
    <!-- Tasks From Asset -->
    <record id="tsm_tasks_from_tech_asset_action" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">tsm.task</field>
        <field name="view_mode">list,kanban,form</field>
        <field
            name="domain"
        >[('asset_ids', 'in', [active_id]), '|',('active', '=', True), ('active', '=', False)]</field>
        <field name="context">{}</field>
        <field name="search_view_id" ref="tsm_base.tsm_task_search_view" />
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Here, you can create new task
            </p>
            <p>
                You can now manage your tasks in order to get things done efficiently. Track progress, discuss, attach documents, etc.
            </p>
        </field>
    </record>

    <!--
       Asset: Views
    -->
    <record id="tsm_tech_assets_form_view" model="ir.ui.view">
        <field name="name">TSM Tech Assets tsm.tech.assets.form</field>
        <field name="model">tsm.tech.asset</field>
        <field name="arch" type="xml">
            <form string="Tech Assets" class="o_form_project_tasks">
                <header>
                    <button
                        name="action_tech_asset_send"
                        type="object"
                        groups="tsm_base.group_tsm_user"
                        string=" Send by Email"
                        class="oe_highlight"
                        icon="fa-envelope"
                    />
                </header>
                <sheet string="Asset">
                    <field name="active" invisible="1" />
                    <field name="can_edit" invisible="1" />
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_stat_button"
                            type="action"
                            name="%(tsm_tasks_from_tech_asset_action)d"
                            icon="fa-tasks"
                        >
                            <field
                                string="Tasks"
                                name="task_count"
                                widget="statinfo"
                                context="{'active_test': False}"
                            />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <field name="write_date" invisible="1" />
                    <!-- To make invisible on create -->
                    <div class="oe_title pe-0">
                        <h2 class="d-flex justify-content-between align-items-center">
                            <div class="d-flex w-100">
                                <field
                                    name="priority"
                                    widget="priority"
                                    class="me-3"
                                    style="flex-basis: 3%"
                                    invisible="not write_date"
                                />
                                <field
                                    name="code"
                                    class="me-3"
                                    style="flex-basis: 15%"
                                    invisible="not write_date"
                                />
                                <field
                                    name="name"
                                    class="me-3 pe-2"
                                    placeholder="Asset Title..."
                                />
                            </div>
                            <button
                                type="object"
                                name="action_inactive"
                                class="btn btn-link text-danger"
                                icon="fa-check fa-2x"
                                title="Active"
                                help="Archive Asset"
                                invisible="not active"
                            />
                            <button
                                type="object"
                                name="action_active"
                                class="btn btn-link text-success"
                                icon="fa-undo fa-2x"
                                title="Inactive"
                                help="Unarchive Asset"
                                invisible="active"
                            />
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field
                                name="user_id"
                                options="{'no_create': True, 'no_open': True}"
                                readonly="not can_edit"
                            />
                            <field
                                name="partner_id"
                                options="{'no_create': True}"
                                context="{'default_partner_id':partner_id}"
                                readonly="not can_edit"
                            />
                        </group>
                        <group>
                            <field name="type_id" widget="selection" />
                            <field name="date" readonly="not can_edit" />
                            <field
                                name="privacy_visibility"
                                widget="radio"
                                readonly="not can_edit"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page name="notes" string="Notes">
                            <div class="row">
                                <div class="col-xs-12 col-sm-6">
                                    <h4>Technical Notes:</h4>
                                    <field
                                        name="tech_notes"
                                        options="{'codeview':true}"
                                    />
                                </div>
                                <div class="col-xs-12 col-sm-6">
                                    <h4>Configuration Notes:</h4>
                                    <field
                                        name="config_notes"
                                        options="{'codeview':true}"
                                    />
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="tsm_tech_assets_tree_view" model="ir.ui.view">
        <field name="name">TSM Tech Assets tsm.tech.assets.list</field>
        <field name="model">tsm.tech.asset</field>
        <field name="arch" type="xml">
            <list
                decoration-muted="active == False"
                decoration-bf="priority == '1'"
                decoration-danger="activity_state != False"
            >
                <field name="sequence" widget="handle" />
                <field name="code" />
                <field name="priority" widget="priority" column_invisible="True" />
                <field name="type_id" string="Asset Type" />
                <field name="name" string="Asset Title" />
                <field name="partner_id" string="Client" />
                <field name="user_id" string="Responsible" />
                <field name="date" string="Date" widget="date" />
                <field name="active" column_invisible="True" />
                <field name="activity_state" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="tsm_tech_assets_kanban_view" model="ir.ui.view">
        <field name="name">tsm.tech.assets.kanban</field>
        <field name="model">tsm.tech.asset</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="user_id" />
                <field name="active" />
                <field name="message_needaction_counter" />
                <field name="activity_ids" />
                <field name="activity_state" />
                <templates>
                    <t t-name="menu" groups="base.group_user">
                        <a
                            role="menuitem"
                            type="open"
                            class="dropdown-item"
                        >Edit Asset</a>
                        <div role="separator" class="dropdown-divider" />
                        <a
                            role="menuitem"
                            name="toggle_active"
                            type="object"
                            class="dropdown-item"
                        >(Un)Archive</a>
                        <a
                            role="menuitem"
                            type="delete"
                            class="dropdown-item"
                        >Delete</a>
                    </t>
                    <t t-name="card">
                        <div class="oe_kanban_content oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <small class="text-primary">
                                        <field name="partner_id" />
                                    </small>
                                    <hr class="mt0 mb4" />
                                    <t
                                        t-if="record.active.raw_value == false"
                                        t-set="muted"
                                    >text-muted</t>
                                    <span
                                        t-attf-class="#{muted || 'o_kanban_record_title'}"
                                    >
                                        [<field name="code" />]
                                        <field name="name" />
                                    </span>
                                </div>
                            </div>

                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="priority" widget="priority" />
                                    <field
                                        name="activity_ids"
                                        widget="kanban_activity"
                                    />
                                    <t
                                        t-if="record.message_needaction_counter.raw_value"
                                    >
                                        <span
                                            role="alert"
                                            class="oe_kanban_mail_new"
                                            title="Unread Messages"
                                        >
                                            <i
                                                class="fa fa-comments"
                                                role="img"
                                                aria-label="Unread Messages"
                                            />
                                            <t
                                                t-out="record.message_needaction_counter.raw_value"
                                            />
                                        </span>
                                    </t>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field
                                        name="user_id"
                                        widget="many2one_avatar_user"
                                        readonly="True"
                                        options="{'no_open': True}"
                                    />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="tsm_tech_assets_search_view" model="ir.ui.view">
        <field name="name">Tsm Tech Assets Search</field>
        <field name="model">tsm.tech.asset</field>
        <field name="arch" type="xml">
            <search string="Tech Assets">
                <field name="partner_id" />
                <field name="name" string="Asset Name" />
                <field name="type_id" string="Asset Type" />
                <field name="user_id" />
                <field name="code" string="Asset Code" />
                <filter
                    string="My Assets"
                    name="my_assets"
                    domain="[('user_id','=',uid)]"
                />
                <filter
                    string="Starred"
                    name="starred"
                    domain="[('priority', '=', '1')]"
                />
                <separator />
                <filter
                    string="My Activities"
                    name="activities_my"
                    domain="[('activity_ids.user_id', '=', uid)]"
                />
                <filter
                    string="Late Activities"
                    name="activities_overdue"
                    domain="[('activity_ids.date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"
                />
                <filter
                    string="Today Activities"
                    name="activities_today"
                    domain="[('activity_ids.date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"
                />
                <filter
                    name="week"
                    string="For This Week"
                    domain="[                                 '&amp;',                                 ('activity_ids.date_deadline', '&gt;=', (context_today() + relativedelta(weeks=-1,days=1,weekday=0)).strftime('%Y-%m-%d')),                                 ('activity_ids.date_deadline', '&lt;=', (context_today() + relativedelta(weekday=6)).strftime('%Y-%m-%d')),]"
                />
                <filter
                    string="For This Month"
                    name="this_month"
                    domain="[                                 '&amp;',                                 ('activity_ids.date_deadline', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),                                 ('activity_ids.date_deadline', '&lt;=', (context_today() + relativedelta(months=1, day=1, days=-1)).strftime('%Y-%m-%d')),]"
                />
                <filter
                    string="Future Activities"
                    name="activities_upcoming_all"
                    domain="[('activity_ids.date_deadline', '&gt;', context_today().strftime('%Y-%m-%d'))]"
                />
                <separator />
                <filter
                    string="Unread Messages"
                    name="message_needaction"
                    domain="[('message_needaction','=',True)]"
                />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active','=',False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        string="Responsible"
                        name="User"
                        context="{'group_by':'user_id'}"
                    />
                    <filter
                        string="Customer"
                        name="customer"
                        context="{'group_by':'partner_id'}"
                    />
                    <filter
                        string="Type"
                        name="Type"
                        context="{'group_by':'type_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!--========================
        Asset: Menus and Actions
    =========================-->
    <record id="tsm_tech_assets_open_all_action" model="ir.actions.act_window">
        <field name="name">T.S.M: Tech Assets</field>
        <field name="res_model">tsm.tech.asset</field>
        <field name="view_id" ref="tsm_tech_assets_tree_view" />
        <field name="view_mode">list,form,kanban,activity</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new tech asset.
            </p>
        </field>
    </record>

    <menuitem
        id="tsm_tech_assets_menu"
        action="tsm_tech_assets_open_all_action"
        name="Tech Assets"
        parent="tsm_base.tsm_main_menu"
        sequence="7"
    />

    <!-- Assign/Unassign Followers to Assets -->
    <record id="assets_follower_assignment_action" model="ir.actions.act_window">
        <field name="name">[Un]Assign Followers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">follower.assignment.wizard</field>
        <field name="view_mode">form,list</field>
        <field name="view_id" ref="tsm_base.follower_assignment_wizard_view" />
        <field name="target">new</field>
        <field name="binding_model_id" ref="tsm_tech_assets.model_tsm_tech_asset" />
    </record>

    <!--========================
        Asset Types: views
    =========================-->
    <record id="tsm_tech_asset_type_search_view" model="ir.ui.view">
        <field name="name">TSM Tech Asset Types Seacrh</field>
        <field name="model">tsm.tech.asset.type</field>
        <field name="arch" type="xml">
            <search string="Types">
                <field name="name" />
            </search>
        </field>
    </record>

    <record id="tsm_tech_asset_type_form_view" model="ir.ui.view">
        <field name="name">TSM Tech Asset Type Form</field>
        <field name="model">tsm.tech.asset.type</field>
        <field name="arch" type="xml">
            <form string="Types">
                <group>
                    <field name="name" />
                </group>
            </form>
        </field>
    </record>

    <record id="tsm_tech_asset_type_list_view" model="ir.ui.view">
        <field name="name">tsm.tech.asset.type.list</field>
        <field name="model">tsm.tech.asset.type</field>
        <field name="arch" type="xml">
            <list string="Types" editable="top" default_order="name">
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="tsm_tech_asset_type_action" model="ir.actions.act_window">
        <field name="name">TSM Tech Asset Types</field>
        <field name="res_model">tsm.tech.asset.type</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="tsm_tech_asset_type_list_view" />
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to add a new type of tech asset.
            </p>
        </field>
    </record>

    <menuitem
        id="tsm_config_tech_asset_type_menu"
        action="tsm_tech_asset_type_action"
        name="Tech Asset Types"
        parent="tsm_base.tsm_config_menu"
        sequence="10"
    />
</odoo>
