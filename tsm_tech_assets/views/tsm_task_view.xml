<odoo>
    <record id="tsm_task_tech_asset_form_view" model="ir.ui.view">
        <field name="name">TSM Task Tech Asset</field>
        <field name="model">tsm.task</field>
        <field name="inherit_id" ref="tsm_base.tsm_task_form_view" />
        <field name="arch" type="xml">
            <field name="date_deadline" position="after">
                <field
                    name="asset_ids"
                    options="{'no_create_edit': True}"
                    domain="[('partner_id', 'child_of', partner_id)]"
                    context="{'default_partner_id':partner_id}"
                >
                    <kanban
                        quick_create="false"
                        can_open="true"
                        records_draggable="false"
                    >
                        <templates>
                            <t t-name="card" class="py-1">
                                <div class="d-flex align-items-center gap-2 w-100">
                                    <div
                                        class="text-truncate flex-grow-1"
                                        t-att-title="record.name.value"
                                    >
                                        <field name="name" />
                                    </div>
                                    <div
                                        class="d-flex flex-column align-items-center flex-shrink-0"
                                    >
                                        <button
                                            class="oe_kanban_action btn btn-link p-0 lh-1"
                                            type="object"
                                            name="open_child_form"
                                            title="Open full form"
                                        >
                                            <i
                                                class="fa fa-caret-right fa-lg"
                                                style="transform: rotate(-45deg)"
                                                aria-hidden="true"
                                            />
                                        </button>
                                        <a
                                            t-if="!read_only_mode"
                                            type="delete"
                                            role="button"
                                            class="btn btn-link text-danger p-0 lh-1"
                                            title="Remove from task"
                                            aria-label="Remove from task"
                                        >
                                            <i
                                                class="fa fa-times text-danger"
                                                aria-hidden="true"
                                            />
                                        </a>
                                    </div>
                                </div>
                            </t>
                        </templates>
                    </kanban>
                </field>
            </field>
        </field>
    </record>
</odoo>
